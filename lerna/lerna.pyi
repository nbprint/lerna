from collections.abc import Callable
from typing import Any

class _Untyped:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

class CallbackManager(_Untyped): ...
class ConfigResult(_Untyped): ...
class ConfigSourceManager(_Untyped): ...
class JobReturn(_Untyped): ...
class LauncherManager(_Untyped): ...
class RustBasicLauncher(_Untyped): ...
class RustBasicSweeper(_Untyped): ...
class RustConfigStore(_Untyped): ...
class RustFileConfigSource(_Untyped): ...
class SweeperManager(_Untyped): ...

class Glob:
    def __init__(self, include: list[str] | None = None, exclude: list[str] | None = None) -> None: ...
    def filter(self, names: list[str]) -> list[str]: ...

class OverrideParser:
    def __init__(self, functions: Any = None) -> None: ...
    def parse_to_dict(self, s: str) -> dict[str, Any]: ...

class RustHybridConfigRepository:
    def __init__(
        self,
        search_paths: list[tuple[str, str]],
        pkg_loader: Callable[[str, str], dict[str, Any] | None] | None = None,
        pkg_config_exists: Callable[[str, str], bool] | None = None,
        pkg_group_exists: Callable[[str, str], bool] | None = None,
        pkg_list_options: Callable[[str, str], list[str]] | None = None,
        structured_loader: Callable[[str], dict[str, Any] | None] | None = None,
        structured_config_exists: Callable[[str], bool] | None = None,
        structured_group_exists: Callable[[str], bool] | None = None,
        structured_list_options: Callable[[str], list[str]] | None = None,
    ) -> None: ...
    def load_config(self, config_path: str) -> Any: ...
    def config_exists(self, config_path: str) -> bool: ...

def escape_special_characters(s: str) -> str: ...
def extract_header_dict(content: str) -> dict[str, str | None]: ...
def get_scheme(path: str) -> str | None: ...
def get_valid_filename(s: str) -> str: ...
def normalize_file_name(filename: str) -> str: ...
def parse_yaml(content: str) -> Any: ...
def __getattr__(name: str) -> Any: ...
